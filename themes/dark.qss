/* SPDX-License-Identifier: GPL-3.0-or-later
 * Shared by Linux / Windows and Qt 5 / Qt 6. All icons are embedded PNGs;
 * the theme needs no SVG plugin, external fonts or installation paths.
 */

QMainWindow, QDialog {
    background: #0c1016;
    color: #e2e9f1;
}
QWidget {
    selection-background-color: #285b78;
    selection-color: #ffffff;
}
QLabel { color: #d6e0ec; background: transparent; }
QLabel:disabled { color: #718094; }
QLabel#statusText, QLabel#imageInfo, QLabel#receiveInfo,
QLabel#beaconBulletinStatus, QLabel#bulletinReaderInfo { color: #99abc0; }
QLabel#receiveStatistics { color: #97becf; }
QLabel#receiveStatus { color: #abc5e1; }
QLabel#outputLevelValue { color: #f3c665; font-weight: 600; }

/* Cards. The headings are separate labels, never painted into a frame gap. */
QFrame[panel="true"] {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #19212b, stop:1 #121820);
    border: 1px solid #344150;
    border-radius: 11px;
}
QFrame[panelHeader="true"], QLabel[panelHeading="true"] {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #202a36, stop:1 #19212b);
    border: none;
    border-bottom: 1px solid #344150;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
}
QLabel[panelHeading="true"] { color: #abc5e1; font-weight: 600; }
QLabel#beaconBulletinHeading { color: #f0c56a; }
QGroupBox[panelBody="true"] {
    background: transparent;
    border: none;
    margin-top: 0;
    padding: 0;
}
QGroupBox {
    background: #151d27;
    border: 1px solid #344150;
    border-radius: 9px;
    margin-top: 0.9em;
    padding-top: 0.5em;
    font-weight: 600;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 6px;
    color: #abc5e1;
}

QMenuBar {
    background: #111720;
    color: #c6d3e3;
    border-bottom: 1px solid #2b3745;
    padding: 3px 7px;
    spacing: 4px;
}
QMenuBar::item { background: transparent; padding: 5px 11px; border-radius: 5px; }
QMenuBar::item:selected { background: #273647; color: #ffffff; }
QMenuBar::item:pressed { background: #31465b; }
QMenu {
    background: #1a232e;
    color: #e2e9f1;
    border: 1px solid #415267;
    border-radius: 7px;
    padding: 5px;
}
QMenu::item { padding: 7px 30px 7px 26px; border-radius: 4px; }
QMenu::item:selected { background: #2a4258; }
QMenu::item:disabled { color: #718094; }
QMenu::separator { height: 1px; background: #344150; margin: 5px 9px; }
QMenu::indicator { width: 14px; height: 14px; }
QMenu::indicator:checked { image: url(:/theme/icons/menu-check.png); }
QMenu::right-arrow { image: url(:/theme/icons/right.png); width: 10px; height: 10px; }
QToolTip {
    background: #253241;
    color: #eef4fa;
    border: 1px solid #566c84;
    border-radius: 5px;
    padding: 6px 9px;
}

/* A little depth at rest, clear feedback on hover, click and keyboard focus. */
QPushButton, QToolButton {
    color: #e2e9f1;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #2c3847, stop:1 #202a36);
    border: 1px solid #435267;
    border-radius: 6px;
    padding: 6px 12px;
    min-height: 16px;
    font-weight: 600;
}
QPushButton:hover, QToolButton:hover { background: #31465b; border-color: #6bb9ef; color: #ffffff; }
QPushButton:focus, QToolButton:focus { border-color: #79c8ff; }
QPushButton:pressed, QToolButton:pressed { background: #152c40; border-color: #79c8ff; }
QPushButton:checked, QToolButton:checked { background: #214c67; border-color: #69c9f0; }
QPushButton:default { border-color: #69c9f0; }
QPushButton:disabled, QToolButton:disabled { color: #718094; background: #19212b; border-color: #2c3744; }
QPushButton#overlayEditButton, QPushButton#transmitButton { padding: 4px 6px; }
QPushButton#transmitButton {
    color: #f4cd75;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #463a23, stop:1 #30291f);
    border-color: #967334;
}
QPushButton#transmitButton:hover, QPushButton#transmitButton:focus {
    background: #584526; color: #ffe3a3; border-color: #f0bf57;
}
QPushButton#transmitButton:pressed { background: #3b2e1a; }
QPushButton#transmitButton[transmitting="true"] { background: #652e37; color: #ffe2e7; border-color: #ef7889; }
QPushButton#transmitButton[transmitting="true"]:hover { background: #873d49; }
QPushButton#transmitButton:disabled { color: #7a735f; background: #24251f; border-color: #414032; }

/* Editors and selectors. Padding is compact enough for a 640-pixel window. */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    color: #e2e9f1;
    background: #101720;
    border: 1px solid #3b4c60;
    border-radius: 6px;
    padding: 5px 8px;
    min-height: 17px;
}
QLineEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover, QComboBox:hover { border-color: #627e9a; }
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus { border-color: #69c9f0; background: #141f2c; }
QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QComboBox:disabled {
    color: #718094; background: #18202a; border-color: #2c3744;
}
QComboBox { padding-right: 26px; }
QComboBox#overlayTextSlot, QComboBox#imageSize { padding: 4px 20px 4px 6px; }
QComboBox::drop-down { subcontrol-origin: padding; subcontrol-position: top right; width: 21px; border: none; }
QComboBox::down-arrow { image: url(:/theme/icons/down.png); width: 10px; height: 10px; }
QComboBox QAbstractItemView {
    background: #1a2532; color: #e2e9f1;
    border: 1px solid #526982;
    outline: none;
    padding: 3px;
    selection-background-color: #2a4a65;
    selection-color: #ffffff;
}
QComboBox QAbstractItemView::item { padding: 5px 8px; min-height: 19px; }
QSpinBox, QDoubleSpinBox { padding-right: 24px; }
QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border; width: 21px; border: none; background: #263646;
}
QSpinBox::up-button, QDoubleSpinBox::up-button { subcontrol-position: top right; border-top-right-radius: 5px; }
QSpinBox::down-button, QDoubleSpinBox::down-button { subcontrol-position: bottom right; border-bottom-right-radius: 5px; }
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover { background: #38546b; }
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow { image: url(:/theme/icons/up.png); width: 9px; height: 9px; }
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow { image: url(:/theme/icons/down.png); width: 9px; height: 9px; }
QPlainTextEdit, QTextEdit, QTextBrowser, QListView, QTreeView, QTableView {
    background: #10161e;
    color: #dce6f1;
    border: 1px solid #303e4e;
    border-radius: 7px;
    padding: 5px;
    alternate-background-color: #18212b;
}
QPlainTextEdit:focus, QTextEdit:focus, QListView:focus, QTreeView:focus, QTableView:focus { border-color: #69c9f0; }
QAbstractItemView { outline: none; }
QAbstractItemView::item:selected { background: #28516b; color: #ffffff; }
QHeaderView::section { background: #263442; color: #bfd0e3; border: none; border-right: 1px solid #3b4c60; padding: 7px; }
QScrollArea { background: transparent; border: none; }

QLabel#imagePreview, QLabel#receivedPreview {
    color: #94a9bf;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #14202d, stop:1 #0d141d);
    border: 1px solid #304357;
    border-radius: 7px;
    padding: 0;
}

QProgressBar {
    color: #eff5fb;
    background: #0f1721;
    border: 1px solid #35465a;
    border-radius: 4px;
    text-align: center;
    padding: 0;
}
QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #256a80, stop:1 #3e9bb1);
    border-radius: 3px;
}
QProgressBar#sendProgress::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #795424, stop:1 #b78836);
}
QProgressBar#receiveProgress::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #24675d, stop:1 #37957b);
}

QCheckBox, QRadioButton { color: #becddd; spacing: 7px; background: transparent; }
QCheckBox:hover, QRadioButton:hover { color: #ffffff; }
QCheckBox:disabled, QRadioButton:disabled { color: #718094; }
QCheckBox::indicator {
    width: 15px; height: 15px;
    background: #111a25;
    border: 1px solid #536b83;
    border-radius: 4px;
}
QCheckBox::indicator:hover, QCheckBox::indicator:focus { border-color: #79c8ff; background: #21364b; }
QCheckBox::indicator:checked { background: #69c9f0; border-color: #69c9f0; image: url(:/theme/icons/check.png); }
QCheckBox::indicator:checked:hover { background: #96ddf8; border-color: #96ddf8; }
QCheckBox::indicator:disabled { background-color: #26313e; border-color: #3f5063; }
QCheckBox::indicator:checked:disabled { background-color: #708ca2; }
QRadioButton::indicator { width: 15px; height: 15px; background: #111a25; border: 1px solid #536b83; border-radius: 8px; }
QRadioButton::indicator:checked { background: #69c9f0; border: 4px solid #2d5367; }
QRadioButton::indicator:hover { border-color: #79c8ff; }

QSlider { background: transparent; }
QSlider::groove:horizontal { height: 5px; background: #283849; border: 1px solid #344a60; border-radius: 3px; }
QSlider::sub-page:horizontal { background: #4cb3d4; border-radius: 3px; }
QSlider::handle:horizontal { background: #c5eafa; border: 1px solid #5ba3c7; border-radius: 7px; width: 12px; margin: -5px 0; }
QSlider::groove:vertical { width: 5px; background: #283849; border: 1px solid #344a60; border-radius: 3px; }
QSlider::add-page:vertical { background: #4cb3d4; border-radius: 3px; }
QSlider::handle:vertical { background: #c5eafa; border: 1px solid #5ba3c7; border-radius: 7px; height: 12px; margin: 0 -5px; }
QSlider::handle:hover, QSlider::handle:focus { background: #ffffff; border-color: #90ddff; }
QSlider::handle:pressed { background: #69c9f0; }
QSlider::handle:disabled { background: #687d90; border-color: #3b4d60; }
QSlider#outputLevel::add-page:vertical { background: #c79b45; }
QSlider#outputLevel::handle:vertical { background: #f1d092; border-color: #c79b45; }
QSlider#outputLevel::handle:vertical:hover { background: #ffe6b3; }

QScrollBar:vertical { background: #111923; width: 10px; margin: 1px; border-radius: 4px; }
QScrollBar:horizontal { background: #111923; height: 10px; margin: 1px; border-radius: 4px; }
QScrollBar::handle:vertical { background: #41576d; min-height: 25px; border-radius: 4px; }
QScrollBar::handle:horizontal { background: #41576d; min-width: 25px; border-radius: 4px; }
QScrollBar::handle:hover { background: #6487a8; }
QScrollBar::handle:pressed { background: #69c9f0; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; border: none; background: none; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }
QAbstractScrollArea::corner { background: #111923; border: none; }
QSplitter { background: transparent; }
QSplitter::handle { background: transparent; }
QSplitter::handle:horizontal { width: 8px; }
QSplitter::handle:vertical { height: 8px; }
QSplitter::handle:hover { background: #344b62; border-radius: 3px; }
QTabWidget::pane { border: 1px solid #344150; border-radius: 7px; background: #151d27; }
QTabBar::tab { background: #202c39; color: #a8bbd0; border: 1px solid #3d4f64; border-radius: 5px; padding: 6px 12px; margin: 2px; }
QTabBar::tab:selected { color: #f4cd75; background: #403722; border-color: #bd913c; }
QTabBar::tab:hover { background: #31465b; color: #ffffff; }
